-static int32_t tw_finish_entity(TerraTwld* t) {
-    if (t->pass == 1 || !t->entry_mod || !t->entry_name) return 0;
-    if (!t->entry_has_x || !t->entry_has_y || t->entry_x >= t->width || t->entry_y >= t->height)
-        return TERRA_TWLD_FORMAT;
