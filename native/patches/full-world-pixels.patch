-static uint32_t tw_name_role(const TerraTwld* t) {
-    if (t->root_name) return TW_ROOT_ROLE;
-    if (!t->depth || t->text_length >= sizeof(t->text)) return TW_OTHER;
-    uint32_t parent = t->stack[t->depth - 1].role;
