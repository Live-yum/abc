-    case 4: case 6: tw_need(t, TW_SCALAR, 8); return 0;
-    case 7: t->array_multiplier = 1; tw_need(t, TW_ARRAY_LENGTH, 4); return 0;
-    case 8: tw_need(t, TW_STRING_LENGTH, 2); return 0;
-    case 9: tw_need(t, TW_LIST, 5); return 0;
-    case 10: {
