-            if (zeros) {
-                if (t->tile_index + zeros / 2u > t->cells) return TERRA_TWLD_FORMAT;
-                int32_t status = tw_output(t, bytes + index, zeros, 0);
-                if (status < 0) return status;
-                t->tile_index += zeros / 2u; index += zeros;
