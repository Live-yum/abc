-static uint32_t tw_zero_prefix(const uint8_t* data, uint32_t size) {
-    uint32_t count = 0;
-    while (size - count >= 8) {
-        uint64_t value; memcpy(&value, data + count, 8);
-        if (value) break;
-        count += 8;
-    }
-    while (count < size && data[count] == 0) ++count;
-    return count;
-}
